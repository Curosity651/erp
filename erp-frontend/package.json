    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.9.7",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.1.1",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.7.0",
    "@wangeditor/core": "^1.1.19",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^8.0.3",
    "less": "^4.1.3",
    "lint-staged": "^13.2.2",
    "npm-run-all": "^4.1.5",
